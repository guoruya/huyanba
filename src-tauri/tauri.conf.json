{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "huyanba",
  "version": "2.4.0",
  "identifier": "com.admin.huyanba",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "huyanba",
        "width": 800,
        "height": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.unsplash.com https://www.dpm.org.cn https://*.dpm.org.cn",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://images.unsplash.com https://plus.unsplash.com https://*.dpm.org.cn",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420 http://127.0.0.1:1420 ipc: http://ipc.localhost asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421 http://127.0.0.1:1420 ws://127.0.0.1:1420 ws://127.0.0.1:1421 https://api.unsplash.com https://www.dpm.org.cn https://*.dpm.org.cn",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://images.unsplash.com https://plus.unsplash.com https://*.dpm.org.cn",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420 http://127.0.0.1:1420 https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "script-src": "'self' http://localhost:1420 http://127.0.0.1:1420 'unsafe-eval'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/wallpapers/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
